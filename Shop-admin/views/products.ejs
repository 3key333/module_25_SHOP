<h1>Products (<%=items.length%>)</h1>

<form action="search" method="get" class="products-search-form">

    <div class="products-search">

        <div>
            <label for="filter-input">Title:</label>
            <input id="filter-input" type="text" name="title" value="<%= queryParams?.title || '' %>">
        </div>

        <div>
            <label for="filter-description">Descriprion:</label>
            <input id="filter-description" type="text" name="description">
        </div>

        <div>
            <label for="filter-price-from">Price from:</label>
            <input id="filter-price-from" type="text" name="priceFrom" value="<%= queryParams?.priceFrom || '' %>">
        </div>

        <div>
            <label for="filter-price-to">Price To:</label>
            <input id="filter-price-to" type="text" name="priceTo" value="<%= queryParams?.priceTo || '' %>">
        </div>

    </div>

    <button type="submit">Search</button>
    <a href="<%= `/${process.env.ADMIN_PATH}` %>">Reset filter</a>

</form>

<div class="products-list">
    <% items.forEach(function(product) { %>
        <div class="product">

            <div class="image">
                <img src="<%= product.thumbnail?.url || 'img/product-placeholder.png' %>"alt="<%= product.title %>">
            </div>

            <div class="info">

                <a class="title" href="<%= `${product.id}` %>">
                    <%= product.title %>
                </a>

                <div>
                    <span class="label">Images:</span>
                    <%= product.images?.length || 0 %>
                </div>

                <div>
                    <span class="label">Price:</span>
                    <%= product.price %>
                </div>

            </div>

        </div>
    <% }) %>
</div>
